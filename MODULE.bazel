module(
    name = "go-workq",
    version = "0.0.1",
)

bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.52.2")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

# Use Gazelle's go_deps to read go.mod and expose module repos
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
go_deps.gazelle_override(
    path = "github.com/freshdresch/go-data-structures",
    build_file_generation = "clean",
)

# Import Github modules as repos
use_repo(
    go_deps,
    "com_github_freshdresch_go_data_structures",
    "com_github_mattn_go_sqlite3",
    "com_github_stretchr_testify",
)
