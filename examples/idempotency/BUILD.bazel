load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "idempotency_lib",
    srcs = [
        "client.go",
        "listener.go",
        "main.go",
        "owner.go",
        "protocol.go",
        "response.go",
        "server.go",
        "source.go",
        "worker.go",
    ],
    importpath = "github.com/freshdresch/go-data-structures/workq/examples/idempotency",
    visibility = ["//visibility:private"],
    deps = ["//workq/durable", "//workq/examples/internal/inventory"],
)

go_binary(
    name = "idempotency",
    embed = [":idempotency_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "idempotency_test",
    srcs = [
        "client_test.go",
        "main_test.go",
        "owner_test.go",
        "recovery_test.go",
        "response_fuzz_test.go",
        "response_test.go",
        "server_test.go",
    ],
    embed = [":idempotency_lib"],
    deps = [
        "//workq/durable",
        "//workq/examples/internal/inventory",
        "@com_github_stretchr_testify//assert:assert",
        "@com_github_stretchr_testify//require:require",
    ],
)
